{
  "name": "@agents-kit/runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local LangGraph runner for the agents-kit delivery graph. No cloud, no extra model key.",
  "bin": {
    "agents-kit": "./bin/agents-kit"
  },
  "scripts": {
